DEBUG=true
ENV=local

SECRET_KEY=dev-only-secret-key-change-me
OPENAI_API_KEY=replace-with-openai-api-key
ALLOWED_HOSTS=localhost,127.0.0.1,text2sql-server,server
FRONTEND_URL=http://localhost:4174

MYSQL_DATABASE=text2sql_db
MYSQL_USER=text2sql_user
MYSQL_PASSWORD=dev-only-db-password-change-me
MYSQL_ROOT_PASSWORD=dev-only-root-password-change-me
MYSQL_NAME=text2sql_db
MYSQL_HOST=database
MYSQL_PORT=3306

ELASTICSEARCH_HOST=elasticsearch
ELASTICSEARCH_PORT=9200
ELASTICSEARCH_URL=http://elasticsearch:9200
ELASTICSEARCH_USER=
ELASTICSEARCH_PASSWORD=
ELASTICSEARCH_ENABLED=true

# Shared Django cache backend. Compose provides Redis at redis:6379.
CACHE_BACKEND=django_redis.cache.RedisCache
CACHE_LOCATION=redis://redis:6379/1
CACHE_KEY_PREFIX=audql
CACHE_IGNORE_EXCEPTIONS=false
DATA_CACHE_TIMEOUT=300

# Optional Kafka -> Vector -> Loki -> Grafana local observability pipeline.
DEPLOY_ENV=local
KAFKA_LOGGING_ENABLED=true
KAFKA_BOOTSTRAP_SERVERS=kafka:9092
KAFKA_JOB_TOPIC=audql.jobs
KAFKA_JOB_GROUP_ID=audql-workers
KAFKA_LOG_TOPIC=audql.logs
KAFKA_REQUEST_TIMEOUT_MS=15000
KAFKA_API_VERSION_AUTO_TIMEOUT_MS=5000
CLIENT_LOG_RATE=30/min
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=change-me-local

EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
# Resend SMTP settings. The console backend keeps local development from emailing.
EMAIL_HOST=smtp.resend.com
EMAIL_PORT=465
EMAIL_USE_TLS=false
EMAIL_USE_SSL=true
EMAIL_HOST_USER=resend
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=notifications@example.com

FCM_ENABLED=false
FCM_PROJECT_ID=
FCM_SERVICE_ACCOUNT_FILE=
FCM_SERVICE_ACCOUNT_JSON=
