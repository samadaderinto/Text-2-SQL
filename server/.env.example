DEBUG=true
ENV=local

SECRET_KEY=dev-only-secret-key-change-me
OPENAI_API_KEY=replace-with-openai-api-key
ALLOWED_HOSTS=localhost,127.0.0.1
FRONTEND_URL=http://localhost:4174

MYSQL_USER=text2sql_user
MYSQL_PASSWORD=text2sql_password
MYSQL_ROOT_PASSWORD=text2sql_root_password
MYSQL_NAME=text2sql_db
MYSQL_HOST=localhost
MYSQL_PORT=3306

ELASTICSEARCH_URL=http://localhost:9200
ELASTICSEARCH_USER=
ELASTICSEARCH_PASSWORD=
ELASTICSEARCH_ENABLED=true

# Optional Django cache backend; LocMemCache is suitable for single-process setups.
CACHE_BACKEND=django.core.cache.backends.locmem.LocMemCache
CACHE_LOCATION=audql-server-cache
DATA_CACHE_TIMEOUT=300

# Optional Kafka -> Vector -> Loki -> Grafana local observability pipeline.
DEPLOY_ENV=local
KAFKA_LOGGING_ENABLED=false
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_JOB_TOPIC=audql.jobs
KAFKA_JOB_GROUP_ID=audql-workers
KAFKA_LOG_TOPIC=audql.logs
CLIENT_LOG_RATE=30/min
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me-local

EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.example.com
EMAIL_PORT=465
EMAIL_HOST_USER=no-reply@example.com
EMAIL_HOST_PASSWORD=dummy-email-password

VITE_API_BASE_URL=http://localhost:8000
